{
  "version": 2,
  "installCommand": "pip install -r requirements.txt --break-system-packages",
  "buildCommand": "python3 -m reflex export --frontend-only --no-zip",
  "outputDirectory": ".web/build/client",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
